generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  documents     Document[]
  conversations Conversation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// An ingested knowledge source. Content itself lives in PageIndex; this table
/// tracks ownership, ingest status, and a cached copy of the PageIndex tree so
/// retrieval does not refetch the whole structure on every question.
///
/// Uploaded files own their PageIndex document directly. YouTube sources do not:
/// they point at a shared `YoutubeVideo` or `YoutubePlaylist` so the same video
/// is only ever transcribed and indexed once, however many users or playlists
/// reference it.
model Document {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// "pdf" | "doc" | "text" | "vtt" | "youtube" | "playlist"
  sourceKind     String
  /// Set for uploaded files only; YouTube sources index through their relation.
  pageIndexDocId String?
  /// Canonical URL for link-based sources.
  sourceUrl      String?
  /// "queued" | "processing" | "ready" | "failed"
  status         String   @default("queued")
  errorMessage   String?
  pageCount      Int?
  /// Flattened PageIndex tree, cached once processing completes.
  tree           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  youtubeVideoId String?
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  youtubePlaylistId String?
  youtubePlaylist   YoutubePlaylist? @relation(fields: [youtubePlaylistId], references: [id], onDelete: Cascade)

  @@unique([pageIndexDocId])
  @@index([userId])
  @@index([youtubeVideoId])
  @@index([youtubePlaylistId])
  @@map("document")
}

/// A YouTube video, cached at video-id granularity rather than per user or per
/// playlist, because the same video routinely appears in several playlists and
/// there is no reason to transcribe or index it more than once.
///
/// `transcriptStatus` is separate from availability: metadata is cheap and is
/// always filled in, while the transcript and PageIndex tree are only built when
/// something actually needs the video's contents.
model YoutubeVideo {
  id              String   @id @default(cuid())
  /// The 11-character YouTube video id.
  videoId         String
  title           String
  description     String
  channelTitle    String
  publishedAt     DateTime
  durationSeconds Int      @default(0)
  thumbnailUrl    String?
  /// "available" | "unavailable" | "live"
  availability    String   @default("available")

  /// "pending" | "queued" | "processing" | "ready" | "failed"
  transcriptStatus String  @default("pending")
  errorMessage     String?
  transcriptLang   String?
  autoGenerated    Boolean @default(false)
  pageIndexDocId   String?
  pageCount        Int?
  /// Flattened PageIndex tree of the transcript, cached once built.
  tree             Json?
  /// One-line gist used by playlist-level routing, so picking which video to
  /// read never has to touch a full transcript.
  summary          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]
  playlistItems YoutubePlaylistItem[]

  @@unique([videoId])
  @@unique([pageIndexDocId])
  @@index([transcriptStatus])
  @@map("youtube_video")
}

/// A playlist's structure, cached separately from its videos so revisiting a
/// playlist does not re-page through `playlistItems.list`. Playlists are mutable,
/// so `lastSyncedAt` drives a periodic refresh.
model YoutubePlaylist {
  id           String   @id @default(cuid())
  playlistId   String
  title        String
  description  String
  channelTitle String
  /// Item count YouTube reports, which includes entries we could not ingest.
  itemCount    Int      @default(0)
  /// True when the playlist is longer than the configured ingest cap.
  truncated    Boolean  @default(false)
  /// Entries that were listed but are private or deleted.
  unavailableCount Int  @default(0)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items     YoutubePlaylistItem[]
  documents Document[]

  @@unique([playlistId])
  @@map("youtube_playlist")
}

/// One video's slot in one playlist. `position` is curation order, which is not
/// necessarily upload order — "the most recent video" has to be answered from
/// `YoutubeVideo.publishedAt`, not from position.
model YoutubePlaylistItem {
  id         String @id @default(cuid())
  playlistId String
  playlist   YoutubePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoId    String
  video      YoutubeVideo    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([playlistId, videoId])
  @@index([playlistId, position])
  @@map("youtube_playlist_item")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// A multi-turn chat thread owned by one user.
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
  @@map("conversation")
}

/// One turn in a conversation. Assistant rows may carry citation payloads.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role           String
  content        String
  /// AnswerCitation[] for assistant messages; null for user turns.
  citations      Json?
  /// OptimizedQuery snapshot for assistant messages.
  queries        Json?
  /// PendingVideo[] when playlist routes hit videos still building.
  pendingVideos  Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}
